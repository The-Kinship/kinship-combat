{
  "name": "kinship-combat",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "kinship-combat-db", "database_id": "PASTE-YOUR-DATABASE-ID-HERE", "migrations_dir": "migrations" }
  ]
}
