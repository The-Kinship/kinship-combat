{
  "name": "kinship-combat",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "kinship-combat-db", "database_id": "abeec4b1-5cd0-4678-9d39-c09a7e0022ac", "migrations_dir": "migrations" }
  ]
}
